# Скопируйте в .env и при необходимости отредактируйте.

# Откуда собираются образы уровней и сервисов (git build-context).
# По умолчанию — публичный GitHub-репозиторий. Для приватного репозитория
# либо сделайте его публичным, либо укажите локальный форк/зеркало.
REPO=https://github.com/svend4/daten2.git

# Необязательно: включает LLM-движки (Claude) в роутере, витрине, управляющем и поиске.
# Без ключа все они работают в детерминированном режиме.
ANTHROPIC_API_KEY=

# Секрет подписи токенов общего auth-сервиса (профиль commerce).
AUTH_SECRET=change-me-in-prod
