<!doctype html>
<html lang="ru">
<head>
  <meta charset="utf-8"/>
  <title>Заказ принят</title>
  <link rel="stylesheet" href="/public/style.css"/>
</head>
<body>
<div class="wrap">
  <h1>✅ Заказ #<%= order.id %> принят</h1>
  <p>Спасибо, <%= order.customer_name %>!<% if (order.phone) { %> Мы свяжемся с вами по телефону <%= order.phone %>.<% } %></p>
  <p class="muted">Номер для отслеживания: <code><%= order.order_number %></code></p>

  <h3>Состав заказа</h3>
  <ul>
    <% items.forEach(i => { %>
      <li><%= i.product_name %> × <%= i.quantity %> — <%= Number(i.line_total).toFixed(2) %> €</li>
    <% }) %>
  </ul>
  <p class="price">Итого: <%= Number(order.total_amount).toFixed(2) %> €
    <span class="muted">(оплата: <%= order.payment_status %>)</span></p>

  <a href="/">На главную</a>
</div>
</body>
</html>
